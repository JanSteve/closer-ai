# ==============================================================================
# CLOSER AI - Autonomous Voice-Native Real Estate Lead Qualification Engine
# Environment Configuration Template
# ==============================================================================

# LLM Providers (Groq recommended for sub-300ms time-to-first-token)
GROQ_API_KEY=gsk_your_groq_api_key_here
OPENAI_API_KEY=sk-your_openai_api_key_here
LLM_MODEL=llama-3.3-70b-versatile
LLM_TEMPERATURE=0.3

# Voice & Telephony (Edge TTS is zero-cost; Twilio for cellular carrier dispatch)
DEFAULT_VOICE=en-US-GuyNeural
FALLBACK_VOICE=en-US-AriaNeural
SPEECH_RATE=+7%
AUDIO_SAMPLE_RATE=24000
TWILIO_ACCOUNT_SID=AC_your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+13105550199

# Real Estate Brokerage Identity
BROKERAGE_NAME="Daniel & Associates Luxury Realty"
REALTOR_NAME="R Jan Steve Daniel"
REALTOR_TITLE="Principal Luxury Real Estate Broker"
REALTOR_PHONE="+1-310-555-0199"
REALTOR_EMAIL="steve@danielrealty.com"
PRIMARY_MARKETS="Beverly Hills, Bel Air, Malibu, Holmby Hills, Tribeca"

# Calendar & Appointment Booking
GOOGLE_CALENDAR_ID=primary
GOOGLE_SERVICE_ACCOUNT_JSON=credentials/google_service_account.json
BOOKING_TIMEZONE=America/Los_Angeles
TOUR_DURATION_MINUTES=45
BUFFER_MINUTES=15

# CRM & Webhook Integrations (Follow Up Boss / Zapier / Make)
FOLLOW_UP_BOSS_API_KEY=fub_your_api_key_here
CRM_WEBHOOK_URL=https://api.followupboss.com/v1/events
WEBHOOK_SECRET=your_secure_webhook_signing_secret_here

# Server & Network Ports
PORT=8000
HOST=0.0.0.0
WEB_PORT=8501
ENVIRONMENT=development
DEBUG=true
