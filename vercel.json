{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py"
    }
  ],
  "redirects": [
    {
      "source": "/console",
      "destination": "/#voice-test",
      "permanent": false
    },
    {
      "source": "/dashboard",
      "destination": "/#voice-test",
      "permanent": false
    },
    {
      "source": "/admin",
      "destination": "/#voice-test",
      "permanent": false
    }
  ]
}
